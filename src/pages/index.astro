---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>

			<img
  src="/images/banner.png"
  alt="Banner La Órbita"
  class="hero-banner"	
  />

			<h1>🌎 La Órbita</h1>
			<p>
				Archivo histórico y medio de documentación de la Comunidad Robótica ITCM.
			</p>

			<p>
				La Órbita preserva proyectos, eventos, competencias, logros y la 
				historia de las generaciones que han formado parte de la comunidad.
			</p>
			<style>
.hero-banner {
  width: 100%;
  max-width: 1000px;
  height: auto;
  border-radius: 12px;
  margin-bottom: 2rem;
}
</style>
		</main>
		<Footer />
	</body>
</html>
